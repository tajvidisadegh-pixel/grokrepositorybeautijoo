# Copy to backend/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/beautijoo?schema=public

# JWT (use long random strings; access ≠ refresh)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# CORS — exact frontend origin(s), comma-separated in production
CORS_ORIGINS=http://localhost:3000

# ---- Payments (issue #42) ----
# production without zarinpal → online payment DISABLED (safe)
# development empty → mock payment
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true
# ZARINPAL_ACCESS_TOKEN=

# ---- Reminders SMS (optional) ----
# REMINDERS_SMS=true
# REMINDERS_SMS=false

# ---- Booking cancel window (hours before start; default 2) ----
# CANCEL_MIN_HOURS_BEFORE=2

# On container start (production): migrate deploy + seed-roles + seed-catalog run via npm start.
# Manual if needed:
#   npx prisma migrate deploy
#   node prisma/seed-roles.cjs

# Max active bookings per customer (#62.6)
MAX_CONCURRENT_BOOKINGS=3
