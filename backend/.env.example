# Copy to backend/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/beautijoo?schema=public

# JWT (use long random strings; access ≠ refresh)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# CORS — exact frontend origin(s), comma-separated in production
CORS_ORIGINS=http://localhost:3000

# ---- Payments (issue #42) ----
# production without zarinpal → online payment DISABLED (safe)
# development empty → mock payment
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true
# ZARINPAL_ACCESS_TOKEN=
# BOOKING_PAYMENT_MODE=auto

# ---- Reminders SMS (optional) ----
# REMINDERS_SMS=true

# ---- Booking lead / cancel (#82) ----
BOOKING_MIN_LEAD_HOURS=4
# Free full-refund window (hours before start). Alias: CANCEL_MIN_HOURS_BEFORE
BOOKING_FREE_CANCEL_HOURS=24
# CANCEL_MIN_HOURS_BEFORE=24

# Max active bookings per customer
MAX_CONCURRENT_BOOKINGS=3

# ---- OTP limits (#82.med15) ----
# OTP_MAX_PER_IP_10M=20
# OTP_MAX_PER_HOUR=3
# OTP_MAX_PER_DAY=8

# ---- Boot seeds (#82.infra20) ----
# seed-catalog only when explicitly enabled (default off in Dockerfile)
# RUN_SEED_CATALOG_ON_BOOT=false

# ---- Storage (#82.infra19) ----
# Prefer object storage in production (multi-instance / durable)
# STORAGE_PROVIDER=s3
# STORAGE_LOCAL_PATH=/app/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# ---- SMS ----
# SMS_PROVIDER=mock
# ALLOW_MOCK_SMS=false
