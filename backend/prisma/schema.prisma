generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  customer
  professional
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ProfessionalStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum MediaKind {
  image
  video
  document
}

enum MediaStatus {
  pending
  ready
  failed
}

enum DayOfWeek {
  saturday
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  phone         String      @db.VarChar(20)
  email         String?     @db.VarChar(255)
  passwordHash  String?     @map("password_hash") @db.VarChar(255)
  accountType   AccountType @default(customer) @map("account_type")
  status        UserStatus  @default(active)
  phoneVerified Boolean     @default(false) @map("phone_verified")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  profile       Profile?
  professional  Professional?
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  bookings      Booking[]   @relation("CustomerBookings")
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  auditLogs     AuditLog[]  @relation("AuditActor")
  payoutRequests PayoutRequest[]

  @@unique([phone, accountType])
  @@index([status])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(120)
  firstName   String?  @map("first_name") @db.VarChar(80)
  lastName    String?  @map("last_name") @db.VarChar(80)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  bio         String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(80)
  description     String?          @db.VarChar(255)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  phone     String    @db.VarChar(20)
  codeHash  String    @map("code_hash") @db.VarChar(255)
  purpose   String    @db.VarChar(40)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.Text
  parentId    String?    @map("parent_id") @db.Uuid
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  services    Service[]

  @@index([parentId])
  @@map("categories")
}

model Service {
  id                   String                @id @default(uuid()) @db.Uuid
  categoryId           String                @map("category_id") @db.Uuid
  name                 String                @db.VarChar(150)
  slug                 String                @unique @db.VarChar(160)
  description          String?               @db.Text
  defaultDurationMin   Int                   @default(60) @map("default_duration_min")
  isActive             Boolean               @default(true) @map("is_active")
  category             Category              @relation(fields: [categoryId], references: [id])
  professionalServices ProfessionalService[]

  @@index([categoryId])
  @@map("services")
}

model Professional {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  title                String             @db.VarChar(150)
  slug                 String             @unique @db.VarChar(160)
  bio                  String?            @db.Text
  status               ProfessionalStatus @default(draft)
  isFeatured           Boolean            @default(false) @map("is_featured")
  ratingAvg            Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                @default(0) @map("rating_count")
  logoUrl              String?            @map("logo_url") @db.VarChar(512)
  coverImageUrl        String?            @map("cover_image_url") @db.VarChar(512)
  selectedCategoryIds  Json?              @map("selected_category_ids")
  verifiedAt           DateTime?          @map("verified_at") @db.Timestamptz
  publishedAt          DateTime?          @map("published_at") @db.Timestamptz
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations            ProfessionalLocation[]
  professionalServices ProfessionalService[]
  workingHours         WorkingHour[]
  timeOffs             TimeOff[]
  manualReservations   ManualReservation[]
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  mediaAssets          MediaAsset[]
  payoutRequests       PayoutRequest[]

  @@index([status])
  @@index([isFeatured])
  @@index([ratingAvg])
  @@index([publishedAt])
  @@map("professionals")
}

model Location {
  id         String   @id @default(uuid()) @db.Uuid
  name       String?  @db.VarChar(120)
  address    String   @db.VarChar(500)
  city       String   @db.VarChar(80)
  province   String?  @db.VarChar(80)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  latitude   Decimal? @map("lat") @db.Decimal(10, 7)
  longitude  Decimal? @map("lng") @db.Decimal(10, 7)
  /// exact = pin/public map; approximate = city/area only (coords may be coarse or hidden publicly)
  precision  String   @default("approximate") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  professionalLocations ProfessionalLocation[]
  bookings              Booking[]

  @@index([city])
  @@map("locations")
}

model ProfessionalLocation {
  id             String  @id @default(uuid()) @db.Uuid
  professionalId String  @unique @map("professional_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  isPrimary      Boolean @default(true) @map("is_primary")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([professionalId, locationId])
  @@index([locationId])
  @@map("professional_locations")
}
