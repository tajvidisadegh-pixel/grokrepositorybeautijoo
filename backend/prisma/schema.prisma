// =============================================================================
// Beautijoo Prisma Schema — Single Source of Truth
// PostgreSQL · UUID PKs · UTC timestamps · normalized · production-ready
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  suspended
  deleted
}

enum AccountType {
  customer
  professional
}

enum ProfessionalStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
  completed
  expired
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  cancelled
}

enum PayoutStatus {
  pending
  approved
  paid
  rejected
  cancelled
}

enum NotificationType {
  booking_request
  booking_confirmed
  booking_rejected
  booking_cancelled
  booking_completed
  booking_reminder
  review_request
  system
  otp
}

enum DayOfWeek {
  saturday
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
}

enum Gender {
  female
  male
  other
  undisclosed
}

enum MediaKind {
  avatar
  cover
  logo
  portfolio
  service
  salon
}

enum MediaStatus {
  draft
  published
}
