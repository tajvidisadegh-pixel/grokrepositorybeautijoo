{
  "name": "beautijoo-backend",
  "version": "3.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && nest build",
    "start": "prisma migrate deploy --schema=./prisma/schema.prisma && node prisma/seed-roles.cjs && node prisma/seed-catalog.cjs && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "npm run start",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:seed-roles": "node prisma/seed-roles.cjs",
    "prisma:seed-catalog": "node prisma/seed-catalog.cjs",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "test:e2e:watch": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --watch",
    "test:unit": "NODE_ENV=test jest --config ./test/jest-unit.json --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
