# Copy to .env / set on host. Never commit real secrets.

# CORS — REQUIRED in production (comma-separated absolute origins).
# Dev default (if unset): http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://beautijoo.ir,https://www.beautijoo.ir
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://user:pass@localhost:5432/beautijoo

# JWT — REQUIRED in production (min 32 chars, access ≠ refresh).
# Generate:  openssl rand -hex 32
# Weak placeholders (dev-access-secret-..., changeme, secret, …) are rejected.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=Beautijoo
NEXT_PUBLIC_APP_URL=http://localhost:3001

# OTP security (issue #37 #9)
# TTL of each code in seconds
OTP_TTL_SECONDS=300
# Max wrong verify attempts per code (then code is invalidated)
OTP_MAX_ATTEMPTS=3
# Min seconds between requests for same phone+purpose
OTP_COOLDOWN_SECONDS=60
# Max requests per phone+purpose per rolling hour
OTP_MAX_PER_HOUR=3
# Max requests per phone (all purposes) per rolling day
OTP_MAX_PER_DAY=8

# --- Payments (provider-agnostic) ---
# mock = development/test only. In production mock is blocked; online payment disabled.
# disabled | empty in production = online payment off (no fake PAID).
# Optional real gateway keys when you choose one later (not a project lock-in), e.g. zarinpal
PAYMENT_PROVIDER=mock
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true
# ZARINPAL_ACCESS_TOKEN=

# SMS — mock (dev) | smsir (production)
# Production: SMS_PROVIDER=smsir requires SMSIR_API_KEY + SMSIR_OTP_TEMPLATE_ID
# Template must include a parameter (default name CODE) for the OTP digits.
# Optional SMSIR_LINE_NUMBER for free-text booking notifications.
# Emergency only: ALLOW_MOCK_SMS=true allows mock in production (OTP will not reach phones).
SMS_PROVIDER=mock
# SMSIR_API_KEY=
# SMSIR_OTP_TEMPLATE_ID=
# SMSIR_OTP_PARAM_NAME=CODE
# SMSIR_LINE_NUMBER=
# SMSIR_BASE_URL=https://api.sms.ir
# ALLOW_MOCK_SMS=false
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
