# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined at build time for production.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Beautijoo

# Optional — Neshan map tiles / static map (issue #33 / #42).
# Without this key: routing links still work; map may fall back to OSM tiles.
# Get a web API key from https://platform.neshan.org then rebuild frontend.
# NEXT_PUBLIC_NESHAN_API_KEY=
